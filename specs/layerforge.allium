-- allium: 3
-- layerforge.allium
--
-- Scope: one run of the `layerforge` command, from options to SVG files.
-- Includes: option validation, scaling, slice positions, reference marks,
--   SVG output.
-- Excludes:
--   - Mesh file parsing (trimesh owns it; a mesh is external here)
--   - Drawing details such as stroke widths and text position fallbacks
--   - Packaging, CI and documentation (see docs/requirements.md NFR-1 to NFR-7)
--
-- Rule names carry the requirement IDs from docs/requirements.md.
-- Behavior that differs from intent is listed under Open Questions (G-n).
-- The target for alignment (TR-n) is in specs/alignment.allium.

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity Mesh {
    -- A single triangle mesh. Geometry is computed by black box functions.
    min_z: Decimal
    max_z: Decimal
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

external entity Operator {
    -- The person running the command.
}

value Point {
    x: Decimal
    y: Decimal
}

value Appearance {
    shape: String
    size: Decimal
    angle: Decimal          -- radians
    color: String?
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    default_units: String = "mm"
    default_layer_height: Decimal = 3.0 -- millimetres, stated in the units of the run (TR-13)
    default_kerf: Decimal = 0.3         -- millimetres, stated in the units of the run (TR-6)
    default_angle: Decimal = 0.0        -- degrees, as the option takes them; the run holds radians
    default_min_web_ratio: Decimal = 0.5
    default_min_hole_ratio: Decimal = 1.0
    default_min_hole_kerf_factor: Decimal = 1.5
    default_shapes: List<String> = ["circle", "square", "triangle", "arrow"]
    -- No default number for mark size, minimum distance and tolerance: each follows
    -- the sheet unless it is set (FR-21). The tolerance is this fraction of the size.
    tolerance_factor: Decimal = 0.1
    candidate_points_wanted: Integer = 4
    candidate_attempts: Integer = 40
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity Run {
    units: String                       -- mm, cm or in: the unit of the mesh and of every length (FR-31)
    layer_height: Decimal               -- the sheet thickness
    kerf: Decimal                       -- the width of material the tool removes (TR-6)
    scale_factor: Decimal?
    target_height: Decimal?
    requested_tolerance: Decimal?       -- null: follows the mark size (TR-10)
    requested_min_distance: Decimal?    -- null: the mark size (TR-6)
    requested_mark_size: Decimal?       -- null: the least hole size for the sheet (TR-6)
    min_web_ratio: Decimal              -- times layer_height: the least material between holes and outlines (TR-5)
    min_hole_ratio: Decimal             -- times layer_height: a term of the least hole size (TR-6)
    min_hole_kerf_factor: Decimal       -- times kerf: the other term (TR-6)
    available_shapes: List<String>
    angle: Decimal                      -- radians; the command takes degrees
    config_error: String?               -- set when the config file is unreadable or has a bad key or value (FR-30)
    color: String?
    mesh: Mesh
    output_folder: String
    status: requested | rejected | scaled | sliced | written

    height: mesh.max_z - mesh.min_z
    all_drawn: slices.count > 0 and slices.all(s => s.status = drawn)
    slices: Slice with run = this
    marks: RegisteredMark with run = this   -- shared by every slice in the run

    -- FR-21: none of these depends on the model or on where a mark lies.
    min_mark_size: max(min_hole_ratio * layer_height, min_hole_kerf_factor * kerf)
    mark_size: requested_mark_size ?? min_mark_size
    min_distance: requested_min_distance ?? mark_size
    tolerance: requested_tolerance ?? config.tolerance_factor * mark_size

    transitions status {
        requested -> rejected
        requested -> scaled
        scaled -> sliced
        sliced -> written
        terminal: rejected, written
    }
}

entity RegisteredMark {
    run: Run
    at: Point
    appearance: Appearance
}

entity Slice {
    run: Run
    index: Integer
    position: Decimal                   -- z height of the cutting plane
    contours: Set<Contour>
    marks: PlacedMark with slice = this
    status: planned | cut | marked | adjusted | drawn

    transitions status {
        planned -> cut
        cut -> marked
        marked -> adjusted
        adjusted -> drawn
        terminal: drawn
    }

    invariant IndexMatchesOrder {
        index >= 0
    }
}

entity Contour {
    -- One polygon of a cut, in the model's x and y coordinates. It may have
    -- holes, which come from loops nested inside it.
    slice: Slice
}

entity PlacedMark {
    slice: Slice
    contour: Contour
    at: Point
    appearance: Appearance
}

entity SvgFile {
    slice: Slice
    folder: String
    name: String                        -- slice_NNN.svg
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- Command line (FR-1 to FR-6) ---------------------------------------------

rule FR1_StartRun {
    when: LayerforgeInvoked(person, stl_file, options)
    ensures:
        Run.created(
            mesh: load_single_mesh(stl_file),
            units: options.units,
            layer_height: options.layer_height,
            kerf: options.kerf,
            scale_factor: options.scale_factor,
            target_height: options.target_height,
            requested_tolerance: options.mark_tolerance,
            requested_min_distance: options.mark_min_distance,
            requested_mark_size: options.mark_size,
            min_web_ratio: config.default_min_web_ratio,
            min_hole_ratio: config.default_min_hole_ratio,
            min_hole_kerf_factor: config.default_min_hole_kerf_factor,
            available_shapes: options.available_shapes,
            angle: radians(options.mark_angle),
            config_error: settings_file_error(options),
            color: options.mark_color,
            output_folder: options.output_folder,
            status: requested
        )
    @guidance
        -- The file is required. The command prompts for it only after the config
        -- file and every option have been checked (the rules below), so a bad
        -- option is reported before the person types a path. A file
        -- with more than one geometry is rejected (FR-7). Defaults are the
        -- config values above (FR-6). Each of units, layer_height, kerf,
        -- mark_size, tolerance, min_distance, shapes and angle is the option if
        -- given, else the config file value, else the default (FR-30). The
        -- defaults of layer_height and kerf are millimetres, stated in the
        -- units of the run when nobody set them (FR-31); a value that is given
        -- is already in those units. Mark size, tolerance and min_distance have
        -- no default number: they follow the sheet (FR-21). A config file
        -- that passes its check and is used is named once on stderr: "Using
        -- settings from <file>". min_web_ratio, min_hole_ratio and
        -- min_hole_kerf_factor have no option: each is the config file value,
        -- else the default. Options are checked by the next rules.
}

rule FR30_RejectBadConfigFile {
    when: run: Run.status becomes requested
    requires: run.config_error != null
    ensures: run.status = rejected
    @guidance
        -- The file is --config, or layerforge.toml in the current directory if
        -- it exists. Message: "<file>: <key>: <reason>". Exit code 2. The file is
        -- read once. It is checked before the --stl-file prompt and before the
        -- value checks of the other options, so it comes before
        -- FR4_RejectConflictingScaling. click's own errors come first, whatever
        -- order the options are typed: an unknown option, a value of the wrong
        -- type (--layer-height abc), a missing value, a --config path that does
        -- not exist. They also exit with code 2. --help shows the help and exits
        -- with code 0 even when the file is bad, and it prints no "Using
        -- settings" line; it loses only to a click error (--help --bogus exits 2).
        -- A bad file value fails even when an option overrides it.
        -- A bad option value is reported by the next rules and names the option.
}

rule FR4_RejectConflictingScaling {
    when: run: Run.status becomes requested
    requires: run.scale_factor != null and run.target_height != null
    ensures: run.status = rejected
    @guidance
        -- Message: "Only one of scale_factor or target_height can be provided."
        -- Exit code 1. Any value counts as given, including 0, a negative
        -- number, nan and inf, so the conflict is reported before a bad value
        -- (FR-2, FR-3). A bad config file is reported before it (FR-30). It is
        -- reported before the --stl-file prompt.
}

rule FR2_FR3_RejectNonPositiveValues {
    when: run: Run.status becomes requested
    requires:
        run.layer_height <= 0
        or (run.scale_factor != null and run.scale_factor <= 0)
        or (run.target_height != null and run.target_height <= 0)
    ensures: run.status = rejected
    @guidance
        -- Message: "Invalid value for --<option>: must be > 0". Exit code 2.
        -- A value that is nan or infinite is rejected first, for these options
        -- and for --kerf, --mark-size, --mark-tolerance, --mark-min-distance
        -- and --mark-angle: "must be a finite number". Exit code 2.
        -- --kerf must be >= 0 and --mark-size must be > 0.
        -- --available-shapes is checked in the same way: an empty list or an
        -- unknown shape name gives "Invalid value for --available-shapes" and
        -- exit code 2, before the --stl-file prompt and before the mesh is read.
        -- The checks apply to the merged value, so a value from the config file
        -- is checked in the same way.
}

-- Scaling (FR-8 and FR-9) --------------------------------------------------

-- FR-10: the mesh is not moved after scaling, so a slice keeps the x and y of the model.

rule FR8_ScaleByFactor {
    when: run: Run.status becomes requested
    requires: run.scale_factor != null and run.scale_factor > 0
    requires: run.target_height = null
    requires: run.layer_height > 0
    ensures:
        scale_uniformly(run.mesh, run.scale_factor, about: origin_of_space)
        run.status = scaled
}

rule FR9_ScaleToTargetHeight {
    when: run: Run.status becomes requested
    requires: run.target_height != null and run.target_height > 0
    requires: run.scale_factor = null
    requires: run.layer_height > 0
    ensures:
        scale_uniformly(run.mesh, run.target_height / run.height, about: origin_of_space)
        run.status = scaled
    @guidance
        -- A mesh with no geometry or no height is rejected after it is loaded
        -- with "Cannot load '<file>': <reason>" and exit code 1, so run.height
        -- is always positive here. A missing or unreadable file fails the same
        -- way.
}

rule NoScaling {
    when: run: Run.status becomes requested
    requires: run.scale_factor = null and run.target_height = null
    requires: run.layer_height > 0
    ensures: run.status = scaled
}

-- Slicing (FR-11 to FR-14) ------------------------------------------------

rule FR12_FR14_PlanSlices {
    when: run: Run.status transitions_to scaled
    let positions = slice_positions(run.mesh.min_z, run.mesh.max_z, run.layer_height)
    ensures:
        for i in positions.indices:
            Slice.created(
                run: run,
                index: i,
                position: positions[i],
                contours: {},
                status: planned
            )
        run.status = sliced
    @guidance
        -- slice_positions divides the mesh from min_z upwards into layers of
        -- layer_height, the last one shorter if needed, and returns the middle
        -- of each layer. That is max(1, ceil(height / layer_height)) positions,
        -- all strictly between min_z and max_z.
}

rule FR13_CutSlice {
    when: slice: Slice.status becomes planned
    ensures:
        slice.contours = closed_loops(cut(slice.run.mesh, slice.position))
        slice.status = cut
    @guidance
        -- A plane that cuts nothing gives no contours. Loops are combined by
        -- the even-odd rule, so a loop inside another is a hole of that polygon,
        -- and a loop inside a hole is a polygon of its own. Overlapping shells
        -- give false holes (G-16).
}

-- Reference marks (FR-15 to FR-22) ----------------------------------------

rule FR15_FR21_PlaceMarks {
    when: slice: Slice.status becomes cut
    requires: slice.index = 0 or previous_slice(slice).status in {marked, adjusted, drawn}
    ensures:
        for contour in slice.contours:
            let chosen = choose_mark_point(
                contour,
                already: slice.marks,
                registry: slice.run.marks,
                min_distance: slice.run.min_distance
            )
            if chosen != null:
                let known = nearest_registered(slice.run.marks, chosen, slice.run.tolerance)
                if known != null:
                    -- FR-19: the point is the registered mark, so it keeps
                    -- the stored coordinates and appearance.
                    PlacedMark.created(
                        slice: slice,
                        contour: contour,
                        at: known.at,
                        appearance: known.appearance
                    )
                else:
                    -- FR-20, FR-21: new mark.
                    let appearance = Appearance{
                        shape: next_shape(slice.run.marks, slice.run.available_shapes),
                        size: slice.run.mark_size,
                        angle: slice.run.angle,
                        color: slice.run.color
                    }
                    RegisteredMark.created(run: slice.run, at: chosen, appearance: appearance)
                    PlacedMark.created(
                        slice: slice,
                        contour: contour,
                        at: chosen,
                        appearance: appearance
                    )
        slice.status = marked
    @guidance
        -- choose_mark_point (FR-15 to FR-18): at most one point per contour.
        -- An earlier registered point inside the contour is reused if it is
        -- at least min_distance from the boundary and from marks already
        -- placed on this slice, and if its disc fits (below). Otherwise the candidate with the highest
        -- stability score wins; a candidate within tolerance of a registered
        -- mark or of a mark placed on this slice is skipped (FR-17); candidates are the centroid (if inside the contour) plus points from a
        -- fixed-seed generator inside the bounding box. The score is the sum of pairwise
        -- distances over the candidate and the marks already placed. The hole of
        -- a new mark must fit (TR-5). Its shape and angle are not known yet, so
        -- a mark is a disc that holds the outline of every available shape at its
        -- size (radius: the farthest reach of those outlines from the centre, a
        -- little over half the size for the circle, FR-27): the disc lies inside
        -- the boundary by at least the web, and two discs are at least the web apart.
        -- next_shape gives the first shape not yet registered, else the first
        -- shape (G-5). mark_size is the requested size, else the least hole
        -- size for the sheet (FR-21). A mark_size below min_mark_size logs one
        -- warning for the run and the run goes on (TR-6). Registered marks are shared by
        -- every slice, not only neighbours (G-7).
}

rule FR22_AdjustMarks {
    when: slice: Slice.status becomes marked
    ensures:
        slice.status = adjusted
        for mark in slice.marks:
            if too_close_to_boundary(mark, slice.contours, slice.run.min_distance)
                or too_close_to_earlier_mark(mark, slice.marks, slice.run.min_distance)
                or hole_does_not_fit(
                    mark, slice.contours, slice.run.min_web_ratio * slice.run.layer_height
                )
                or hole_too_close_to_earlier_hole(
                    mark, slice.marks, slice.run.min_web_ratio * slice.run.layer_height
                ):
                not exists mark
    @guidance
        -- hole_does_not_fit is true unless the outline of the mark's shape, at its
        -- size and angle (FR-27), lies wholly inside one contour with the web
        -- (the last argument) to spare, holes of the contour included.
        -- hole_too_close_to_earlier_hole is true when that outline overlaps the
        -- outline of an earlier mark of the slice, or is nearer than the web.
        -- The earlier mark of a close pair stays. Marks dropped here stay in
        -- the run's registry. A slice can end with a contour that has no
        -- mark. One warning is logged for the slice; it is still written.
}

-- SVG output (FR-24 to FR-27) ---------------------------------------------

rule FR24_WriteSvg {
    when: slice: Slice.status becomes adjusted
    ensures:
        SvgFile.created(
            slice: slice,
            folder: slice.run.output_folder,
            name: svg_name(slice.index)
        )
        slice.status = drawn
    @guidance
        -- svg_name(i) is "slice_" plus i as three digits plus ".svg". The file
        -- holds each contour as a black unfilled polygon (plus one for each hole), then each mark, then
        -- the text "Slice N" once per contour (FR-25). A mark is a closed outline
        -- anchored at its centre (FR-27): a circle, or a polygon for the square,
        -- triangle and arrow. Points are drawn at
        -- (x, -y), so the y axis points up as in the model (FR-26). Every file
        -- has the same viewBox, which holds the contours of all slices plus a
        -- 5% margin, so layers can be laid over each other. The root width and
        -- height are the viewBox width and height followed by the unit of the
        -- run (FR-31), so every file has the same physical size. Without a
        -- viewBox they are 100%. Every slice gets a file, including empty ones.
}

rule RunCompletes {
    when: run: Run.all_drawn
    requires: run.status = sliced
    ensures: run.status = written
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant FR17_MarksClearOfBoundaries {
    for mark in PlacedMarks:
        mark.slice.status = drawn implies
            not too_close_to_boundary(mark, mark.slice.contours, mark.slice.run.min_distance)
}

invariant TR5_HolesFit {
    for mark in PlacedMarks:
        mark.slice.status = drawn implies
            not hole_does_not_fit(
                mark,
                mark.slice.contours,
                mark.slice.run.min_web_ratio * mark.slice.run.layer_height
            )
}

invariant FR22_MarksClearOfEachOther {
    for a in PlacedMarks:
        for b in PlacedMarks:
            a != b and a.slice = b.slice and a.slice.status = drawn
                implies distance(a.at, b.at) >= a.slice.run.min_distance
}

invariant FR21_MarkSize {
    for m in RegisteredMarks:
        m.appearance.size = m.run.mark_size
}

invariant FR14_OneSliceEveryPosition {
    for a in Slices:
        for b in Slices:
            a != b and a.run = b.run implies a.index != b.index
}

invariant FR15_AtMostOneMarkPerContour {
    for a in PlacedMarks:
        for b in PlacedMarks:
            a != b implies a.contour != b.contour
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface Command {
    facing person: Operator

    provides:
        LayerforgeInvoked(person, stl_file, options)

    @guarantee OptionsCheckedBeforeWork
        -- Bad option values are reported before the --stl-file prompt and before
        -- the mesh is sliced. A usage error exits with code 2, an option conflict
        -- with code 1. An output folder that is a file, or that would have to be
        -- made inside one, is a usage error: "Invalid value for --output-folder: <file> is
        -- not a folder", where <file> is the existing path in the way. A dangling
        -- symlink counts. An empty or blank output folder is a usage error ("must
        -- not be empty"). So is a folder that cannot be written, or that would have
        -- to be made in a folder that cannot be written ("cannot write to <folder>"),
        -- or a name the system refuses. The check makes and removes a temporary file
        -- in the nearest folder that exists and makes no folder.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

-- G-4  One mark per contour cannot fix rotation.
-- G-5  Shapes do not cycle once all are used.
-- G-7  Marks are inherited from any earlier slice, not only neighbours.
-- G-16 Overlapping shells in one mesh give false holes.
-- G-18 The slice label can cross an outline.
-- G-23 The output suits a screen, not a laser.
-- G-30 A bad --mark-color ends in a traceback while the SVG is drawn.
-- G-4, G-5, G-7, G-18 and G-23 have targets in
-- docs/alignment_requirements.md (TR-1 to TR-16).
